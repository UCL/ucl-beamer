\ProvidesPackage{uclcolors}
\RequirePackage{xcolor}

% All UCL colors are defined in terms of cmyk
\selectcolormodel{cmyk}


% New UCL branding colours defined here: https://www.ucl.ac.uk/brand-and-experience/brand/visual-guidelines/colour
% Lead colours
\definecolor{darkpurple}{cmyk}{0.8,1,0,0.50}
\definecolor{brightpurple}{cmyk}{0.5,0.61,0,0}
\definecolor{midpurple}{cmyk}{0.35,0.42,0,0}

% Supporting colours
\definecolor{palepurple}{cmyk}{0.1,0.15,0,0}
\definecolor{lightpurple}{cmyk}{0.04,0.07,0,0}
\definecolor{heritageblue}{cmyk}{0.55,0,0.05,0}
